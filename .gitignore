# ───────── macOS ─────────
.DS_Store

# ───────── Xcode user data ─────────
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# ───────── XcodeGen ─────────
# project.yml 이 단일 진실원. 생성물 .xcodeproj 는 추적하지 않는다.
# (클론 후 `brew install xcodegen && xcodegen generate` 로 생성)
*.xcodeproj/

# ───────── Build artifacts ─────────
DerivedData/
build/
Build/
*.build/

# ───────── Swift Package Manager ─────────
.swiftpm/
.build/
Package.resolved

# ───────── CocoaPods / Carthage (미사용, 보호용) ─────────
Pods/
Carthage/Build/

# ───────── Fastlane ─────────
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# ───────── App packages ─────────
*.ipa
*.dSYM.zip
*.dSYM

# ───────── Secrets (절대 커밋 금지) ─────────
.env
.env.*
!.env.example
*.p8
*.cer
*.mobileprovision
*.provisionprofile
Secrets.xcconfig

# ───────── Logs / temp ─────────
*.log
tmp/
temp/
